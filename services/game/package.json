{
  "name": "@chessdex/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chessdex gerçek zamanlı oyun sunucusu (WebSocket, sunucu saati, chess.js)",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
